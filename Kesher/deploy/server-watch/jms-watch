def check_internet(cfg):
    hosts = words(cfg["INTERNET_HOSTS"])
    for host in hosts:
        start = time.monotonic()
        try:
            with socket.create_connection((host, 443), timeout=4):
                ms = (time.monotonic() - start) * 1000
                return {"internet": result(True, "Internet", f"erreichbar · {ms:.0f} ms")}
        except OSError:
            continue
    return {"internet": result(False, "Internet", f"keine Verbindung nach außen ({', '.join(hosts)})")}


def check_dns():
    start = time.monotonic()
    code, _, err = run(["getent", "hosts", "api.telegram.org"], timeout=8)
    ms = (time.monotonic() - start) * 1000
    if code == 0:
        return {"dns": result(True, "DNS", f"Namensauflösung klappt · {ms:.0f} ms")}
    return {"dns": result(False, "DNS", "Namensauflösung klappt nicht" + (f" ({err.strip()})" if err.strip() else ""))}


def check_tailscale(cmd, key, name):
    code, out, err = run([*cmd, "status", "--json"], timeout=10)
    if code == 127:
        return {}
    try:
        data = json.loads(out)
    except ValueError:
        return {key: result(False, name, f"antwortet nicht ({(err or out).strip()[:200]})")}
    backend = data.get("BackendState", "?")
    if backend != "Running":
        hint = " – neu anmelden: tailscale up" if backend == "NeedsLogin" else ""
        return {key: result(False, name, f"Zustand {backend}{hint}")}
    ips = (data.get("Self") or {}).get("TailscaleIPs") or []
    peers = list((data.get("Peer") or {}).values())
    online = sum(1 for p in peers if p.get("Online"))
    parts = ["verbunden"]
    if ips:
        parts.append(ips[0])
    parts.append(f"{online} von {len(peers)} Geräten online")
    return {key: result(True, name, " · ".join(parts))}


def parse_docker_time(value):
    try:
        return datetime.fromisoformat(value[:19]).replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        return None


def container_load():
    """CPU und Arbeitsspeicher je Container (docker stats). CPU als Anteil am ganzen Server."""
    code, out, _ = run(["docker", "stats", "--no-stream", "--format", "{{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}"], timeout=25)
    if code != 0:
        return {}
    cores = os.cpu_count() or 1
    loads = {}
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        try:
            cpu = float(parts[1].strip().rstrip("%").replace(",", "."))
        except ValueError:
            continue
        mem = parts[2].split("/")[0].strip()
        mem = re.sub(r"\s*([KMG])iB$", r" \1B", mem).replace(".", ",")
        # docker zählt 100 % je Kern – auf den ganzen Server umrechnen
        loads[parts[0].strip()] = f"CPU {cpu / cores:.0f} % · {mem} RAM".replace("CPU 0 %", "CPU < 1 %")
    return loads


def check_containers(cfg, unknown):
    code, out, err = run(["docker", "ps", "-aq"], timeout=15)
    if code == 127:
        return {}
    if code != 0:
        unknown.update(("container:", "tailscale-container:"))
        return {"docker": result(False, "Docker", f"antwortet nicht ({(err or out).strip()[:200]})")}
    ids = out.split()
    if not ids:
        return {}
    code, out, err = run(["docker", "inspect", *ids], timeout=20)
    if code != 0:
        # z. B. ein Container verschwand zwischen ps und inspect – Zustand bleibt bis zur nächsten Runde
        unknown.update(("container:", "tailscale-container:"))
        return {}
    ignore = set(words(cfg["IGNORE_CONTAINERS"]))
    now = time.time()
    results = {}
    tailscale_containers = []
    loads = container_load()
    for c in sorted(json.loads(out), key=lambda c: c.get("Name", "")):
        name = c.get("Name", "").lstrip("/")
        if not name or name in ignore:
            continue
        st = c.get("State", {})
        policy = c.get("HostConfig", {}).get("RestartPolicy", {}).get("Name", "no")
        expected = policy in ("always", "unless-stopped") or (policy == "on-failure" and st.get("ExitCode", 0) != 0)
        if not expected:
            continue
        key = f"container:{name}"
        status = st.get("Status", "?")
        health = (st.get("Health") or {}).get("Status")
        restarts = c.get("RestartCount", 0)
        if status != "running":
            info = f"läuft nicht (Zustand {status}, Exit-Code {st.get('ExitCode')})"
            if st.get("OOMKilled"):
                info += ", Arbeitsspeicher voll"
            results[key] = result(False, name, info)
            continue
        if health == "unhealthy":
            results[key] = result(False, name, "läuft, meldet sich aber als ungesund (unhealthy)")
            continue
        started = parse_docker_time(st.get("StartedAt", ""))
        parts = [f"läuft seit {fmt_duration(now - started)}" if started else "läuft"]
        if health == "healthy":
            parts.append("gesund")
        elif health == "starting":
            parts.append("startet")
        if restarts:
            parts.append(f"{restarts}× neu gestartet")
        if name in loads:
            parts.append(loads[name])
        results[key] = result(True, name, " · ".join(parts))
        if "tailscale" in c.get("Config", {}).get("Image", ""):
            tailscale_containers.append(name)
    for name in tailscale_containers:
        results.update(check_tailscale(["docker", "exec", name, "tailscale"],
                                       f"tailscale-container:{name}", f"Tailscale ({name})"))
    return results


