def title(key, name):
    noun = noun_of(key)
    return f"<b>{esc(name)}</b>" + (f" · {noun}" if noun else "")


def render_status(cfg, state, now):
    last = state.get("last", {})
    checks = state.get("checks", {})
    at = state.get("last_at")
    failing = [k for k, item in last.items() if not item["ok"]]
    alerted = [k for k in failing if checks.get(k, {}).get("alerted")]
    hints = [k for k in failing if k not in alerted and last[k].get("quiet")]
    watching = [k for k in failing if k not in alerted and k not in hints]
    errors = [k for k in alerted if not last[k].get("warn")]
    warnings = [k for k in alerted if last[k].get("warn")]

    lines = [f"<b>{esc(cfg['SERVER_NAME'])}</b> · Status" + (f" von {fmt_time(at, now)}" if at else "")]
    if alerted:
        summary = []
        if errors:
            summary.append(f"🔴 <b>{len(errors)} Störung{'en' if len(errors) > 1 else ''}</b>")
        if warnings:
            summary.append(f"⚠️ <b>{len(warnings)} Warnung{'en' if len(warnings) > 1 else ''}</b>")
        lines.append(" · ".join(summary))
    elif watching:
        lines.append(f"🟡 <b>Alles läuft</b> – {len(watching)} Auffälligkeit{'en' if len(watching) > 1 else ''} wird beobachtet")
    else:
        lines.append("🟢 <b>Alles in Ordnung</b>"
                     + (f" – {len(hints)} Hinweis{'e' if len(hints) > 1 else ''}" if hints else ""))
    lines.append(f"Server läuft seit {fmt_duration(time.time() - boot_time())}")
    if not last:
        lines.append("\nNoch keine Prüfrunde gelaufen.")
        return "\n".join(lines)

    for gid, heading, _ in GROUPS:
        keys = [k for k in last if group_of(k) == gid]
        if not keys:
            continue
        lines.append("")
        lines.append(f"<b>{heading}</b>")
        # Störungen zuerst, sonst in der Reihenfolge der Prüfung
        for key in sorted(keys, key=lambda k: last[k]["ok"]):
            item = last[key]
            entry = checks.get(key)
            if item["ok"]:
                icon = "🟢"
            elif entry and entry.get("alerted"):
                icon = "⚠️" if item.get("warn") else "🔴"
            elif item.get("quiet"):
                icon = "ℹ️"
            else:
                icon = "🟡"
            info = item["info"].replace("\n", " · ")[:160]
            if entry and not item["ok"]:
                info += f" · seit {fmt_time(entry['down_since'], now)}"
            lines.append(f"{icon} <b>{esc(item['name'])}</b> – {esc(info)}" if info else f"{icon} <b>{esc(item['name'])}</b>")
    return "\n".join(lines)


def plain(text):
    return html.unescape(re.sub(r"</?[a-z]+>", "", text))


