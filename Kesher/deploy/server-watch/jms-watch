def group_of(key):
    if key in ("internet", "dns") or key.startswith(("tailscale:", "tailscale-container:")):
        return "net"
    if key == "docker" or key.startswith("container:"):
        return "container"
    if key.startswith(("unit:", "failed:")):
        return "unit"
    if key.startswith("http:"):
        return "http"
    if key == "youtube":
        return "stream"
    return "system"


def noun_of(key):
    if key == "docker":
        return "Dienst"
    return next(noun for gid, _, noun in GROUPS if gid == group_of(key))


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                cfg[key.strip()] = value.strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    return cfg


def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as fh:
            state = json.load(fh)
    except (FileNotFoundError, ValueError):
        state = {}
    state.setdefault("checks", {})
    state.setdefault("outbox", [])
    state.setdefault("last", {})
    return state


def save_state(state):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(state, fh, ensure_ascii=False, indent=1)
    os.replace(tmp, STATE_FILE)


