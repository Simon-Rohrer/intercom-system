def unit_base(unit):
    return unit[:-8] if unit.endswith(".service") else unit


def unit_label(unit, description=""):
    base = unit_base(unit)
    label = UNIT_LABELS.get(base)
    if not label:
        # Beschreibung der Unit ist meist verständlicher als der technische Name
        desc = description.strip()
        label = desc if desc and desc.lower() != base.lower() else base
    return f"{label} ({base})" if label != base else base


# Zeilen von systemd selbst („Main process exited …“, „Failed with result …“) sagen nichts über
# den Grund – gesucht sind die Ausgaben des Programms
SYSTEMD_NOISE = re.compile(
    r"^(Main process exited|Failed with result|Failed to start|Started |Starting |Stopped |Stopping |"
    r"Deactivated successfully|Consumed |Scheduled restart job|Start request repeated|"
    r"Unit entered failed state|.*\.service: )", re.I)


def unit_logs(unit, invocation=""):
    """Letzte eigene Meldungen des Programms (ohne die Standardzeilen von systemd)."""
    cmd = ["journalctl", "-o", "json", "-n", "40", "--no-pager"]
    cmd += [f"_SYSTEMD_INVOCATION_ID={invocation}"] if invocation else ["-u", unit]
    _, out, _ = run(cmd, timeout=10)
    if invocation and not out.strip():
        _, out, _ = run(["journalctl", "-o", "json", "-n", "40", "--no-pager", "-u", unit], timeout=10)
    lines = []
    for raw in out.splitlines():
        try:
            entry = json.loads(raw)
        except ValueError:
            continue
        msg = entry.get("MESSAGE")
        if isinstance(msg, list):  # Binärdaten
            continue
        msg = (msg or "").strip()
        if not msg or entry.get("SYSLOG_IDENTIFIER") == "systemd" or SYSTEMD_NOISE.match(msg):
            continue
        prio = entry.get("PRIORITY", "6")
        lines.append((int(prio) if str(prio).isdigit() else 6, msg))
    # Fehler und Warnungen bevorzugen, sonst die letzten Zeilen
    errors = [m for p, m in lines if p <= 4]
    picked = (errors or [m for _, m in lines])[-2:]
    return [re.sub(r"\s+", " ", m)[:200] for m in picked]


def explain(texts):
    joined = " ".join(texts)
    for pattern, meaning in REASON_PATTERNS:
        if re.search(pattern, joined, re.I):
            return meaning
    return ""


def failure_reason(unit, props):
    """Warum eine Unit nicht läuft – auf Deutsch, dazu die Originalmeldung des Programms."""
    logs = unit_logs(unit, props.get("InvocationID", ""))
    res = props.get("Result", "")
    status = props.get("ExecMainStatus", "")
    parts = []
    meaning = explain(logs)
    if meaning:
        parts.append(f"Grund: {meaning}")
    elif res in RESULT_TEXT:
        text = RESULT_TEXT[res]
        if res == "exit-code" and status not in ("", "0"):
            text += f" (Fehlercode {status})"
        parts.append(f"Grund: {text}")
    elif props.get("ActiveState") == "inactive":
        parts.append("Grund: Dienst ist gestoppt (von Hand oder nicht gestartet)")
    if logs:
        parts.append("Meldung: " + " | ".join(logs))
    elif not meaning:
        parts.append("Das Programm hat keine eigene Meldung hinterlassen")
    if res in RESULT_TEXT and meaning:
        parts.append(RESULT_TEXT[res] + (f" (Fehlercode {status})" if res == "exit-code" and status not in ("", "0") else ""))
    hint = UNIT_HINTS.get(unit_base(unit))
    if hint:
        parts.append(f"ℹ️ {hint}")
    # Eine Zeile je Angabe; in /status werden daraus „ · “
    return "\n".join(parts)


UNIT_PROPS = "LoadState,ActiveState,SubState,UnitFileState,ActiveEnterTimestampMonotonic,MemoryCurrent," \
             "Description,Result,ExecMainStatus,InvocationID"


def unit_props(unit):
    code, out, _ = run(["systemctl", "show", unit, "-p", UNIT_PROPS], timeout=10)
    return code, dict(l.split("=", 1) for l in out.splitlines() if "=" in l)


def check_units(cfg, unknown):
    results = {}
    ignore = set(words(cfg["IGNORE_UNITS"]))
    booted = boot_time()
    covered = set()
    for unit in words(cfg["WATCH_UNITS"]):
        full = unit if "." in unit else unit + ".service"
        covered.add(full)
        code, props = unit_props(full)
        # Nur Dienste, die es gibt und die beim Start an sein sollen
        if code != 0 or props.get("LoadState") != "loaded" or props.get("UnitFileState") not in ("enabled", "enabled-runtime"):
            continue
        key = f"unit:{full}"
        if props.get("ActiveState") in ("active", "activating", "reloading"):
            parts = ["aktiv"]
            mono = props.get("ActiveEnterTimestampMonotonic", "0")
            if mono.isdigit() and int(mono) > 0:
                parts[0] = f"aktiv seit {fmt_duration(time.time() - (booted + int(mono) / 1e6))}"
            mem = props.get("MemoryCurrent", "")
            if mem.isdigit() and int(mem) < 2**60:
                parts.append(f"{int(mem) / 1e6:.0f} MB RAM")
            results[key] = result(True, unit_label(full, props.get("Description", "")), " · ".join(parts))
        else:
            state = {"failed": "fehlgeschlagen", "inactive": "gestoppt"}.get(props.get("ActiveState"), props.get("ActiveState"))
            results[key] = result(False, unit_label(full, props.get("Description", "")),
                                  f"{state}\n{failure_reason(full, props)}")
    code, out, _ = run(["systemctl", "list-units", "--state=failed", "--plain", "--no-legend", "--no-pager"], timeout=10)
    if code != 0:
        unknown.add("failed:")
    for line in out.splitlines():
        parts = line.replace("●", " ").split()
        if not parts:
            continue
        unit = parts[0]
        if unit in covered or unit in ignore or unit.split(".")[0] in ignore:
            continue
        _, props = unit_props(unit)
        # Hintergrund-Aufgaben von Ubuntu laufen nach Zeitplan immer wieder an und scheitern oft nur
        # kurz (kein Internet, Server im Internet überlastet) – nur Hinweis in /status, keine Meldung
        minor = unit_base(unit) in UNIT_HINTS
        results[f"failed:{unit}"] = result(False, unit_label(unit, props.get("Description", "")),
                                           f"fehlgeschlagen\n{failure_reason(unit, props)}", warn=minor, quiet=minor)
    return results


def check_http(cfg):
    results = {}
    for item in words(cfg["HTTP_CHECKS"]):
        if "=" not in item:
            continue
        name, url = item.split("=", 1)
        key = f"http:{name}"
        start = time.monotonic()
        try:
            with urllib.request.urlopen(url, timeout=6) as resp:
                code = resp.status
        except urllib.error.HTTPError as e:
            code = e.code
        except Exception as e:  # noqa: BLE001 – jede Art „keine Antwort“
            results[key] = result(False, name, f"keine Antwort ({e.__class__.__name__})")
            continue
        ms = (time.monotonic() - start) * 1000
        if code >= 500:
            results[key] = result(False, name, f"Fehler {code}")
        else:
            results[key] = result(True, name, f"antwortet · HTTP {code} · {ms:.0f} ms")
    return results


# Letzter Stand von JMS Control (für die Zusammenfassung nach dem Gottesdienst)
YOUTUBE_STATUS = {}


def check_youtube(cfg, unknown):
    """YouTube-Stream über JMS Control: läuft er, bricht er ab, meldet der ATEM Probleme.
    Nur wenn in JMS Control unter Einstellungen → YouTube eingerichtet."""
    url = cfg["YOUTUBE_STATUS_URL"].strip()
    YOUTUBE_STATUS.clear()
    if not url:
        return {}
    try:
        with urllib.request.urlopen(url, timeout=6) as resp:
            data = json.loads(resp.read().decode("utf-8") or "{}")
    except Exception:  # noqa: BLE001 – JMS Control nicht erreichbar: das meldet schon der Container
        unknown.add("youtube")
        return {}
    YOUTUBE_STATUS.update(data)
    if not data.get("configured"):
        return {}
    problem = data.get("problem")
    info = data.get("info", "")
    if problem:
        return {"youtube": result(False, "YouTube-Stream", f"{problem.get('text', '')}\n{info}",
                                  warn=problem.get("level") != "error")}
    return {"youtube": result(True, "YouTube-Stream", info)}


def youtube_summary(state, now):
    """Nach dem Stream einmal die Zusammenfassung schicken (Spitze, Dauer, Störungen)."""
    summary = YOUTUBE_STATUS.get("summary") or {}
    if not summary.get("id") or state.get("youtube_summary") == summary["id"]:
        return
    first = "youtube_summary" not in state
    state["youtube_summary"] = summary["id"]
    # Beim ersten Lauf keine alte Zusammenfassung nachschicken
    if first and now - (summary.get("at") or 0) / 1000 > 3600:
        return
    queue(state, f"📺 <b>Stream beendet</b>\n{esc(summary.get('text', ''))}")


def check_system(cfg, active=frozenset()):
    results = {}
    usage = shutil.disk_usage("/")
    percent = round(usage.used * 100 / usage.total)
    limit = int(cfg["DISK_WARN_PERCENT"])
    info = f"{percent} % belegt · {fmt_gb(usage.free)} frei von {fmt_gb(usage.total)}"
    ok = below(percent, limit, "disk:/", active)
    results["disk:/"] = result(ok, "Festplatte", info if ok else f"über {limit} % voll: {info}", warn=True)

    try:
        mem = {}
        with open("/proc/meminfo", encoding="ascii") as fh:
            for line in fh:
                k, v = line.split(":", 1)
                mem[k] = int(v.split()[0]) * 1024
        used = mem["MemTotal"] - mem["MemAvailable"]
        percent = round(used * 100 / mem["MemTotal"])
        limit = int(cfg["MEM_WARN_PERCENT"])
        info = f"{percent} % belegt · {fmt_gb(mem['MemAvailable'])} frei von {fmt_gb(mem['MemTotal'])}"
        ok = below(percent, limit, "mem", active)
        results["mem"] = result(ok, "Arbeitsspeicher", info if ok else f"über {limit} % voll: {info}", warn=True)
    except (OSError, KeyError, ValueError):
        pass

    load1, load5, _ = os.getloadavg()
    cores = os.cpu_count() or 1
    results["load"] = result(True, "Prozessor", f"Last {load1:.2f} / {load5:.2f} · {cores} Kerne".replace(".", ","))

    temps = []
    for path in glob.glob("/sys/class/thermal/thermal_zone*/temp") + glob.glob("/sys/class/hwmon/hwmon*/temp*_input"):
        try:
            with open(path, encoding="ascii") as fh:
                value = int(fh.read().strip()) / 1000
            if 0 < value < 150:
                temps.append(value)
        except (OSError, ValueError):
            continue
    if temps:
        hottest = max(temps)
        limit = int(cfg["TEMP_WARN_CELSIUS"])
        ok = below(hottest, limit, "temp", active)
        results["temp"] = result(ok, "Temperatur", f"{hottest:.0f} °C" + ("" if ok else f" (Grenze {limit} °C)"), warn=True)
    return results


def clock_at_boot(booted):
    """Stand die Uhr beim Start falsch? Liefert das falsche Datum als Text oder None.

    Der erste Protokolleintrag des Starts trägt die Uhrzeit, die die Hardware-Uhr lieferte."""
    code, out, _ = run(["journalctl", "--list-boots", "-o", "json", "--no-pager"], timeout=10)
    try:
        boots = json.loads(out) if code == 0 else []
        first = next(b["first_entry"] for b in boots if b.get("index") == 0) / 1e6
    except (ValueError, StopIteration, KeyError, TypeError):
        return None
    if abs(first - booted) > 3600:
        return datetime.fromtimestamp(first, TZ).strftime("%d.%m.%Y %H:%M")
    return None


def check_clock():
    """Systemzeit synchron? Und hält die Hardware-Uhr (RTC) die Zeit – sonst ist nach jedem
    Stromausfall erst einmal ein falsches Datum eingestellt (Zertifikate, Tailscale, Companion)."""
    if not clock_synced():
        return {"clock": result(False, "Uhrzeit", "nicht mit dem Internet abgeglichen – Zertifikate und "
                                                  "Anmeldungen (Tailscale, Companion → Kesher) können scheitern")}
    code, out, _ = run(["hwclock", "--get"], timeout=10)
    if code != 0 or not out.strip():
        return {"clock": result(True, "Uhrzeit", "mit dem Internet abgeglichen")}
    try:
        rtc = datetime.fromisoformat(out.strip().replace(",", ".")).timestamp()
    except ValueError:
        return {"clock": result(True, "Uhrzeit", "mit dem Internet abgeglichen")}
    drift = rtc - time.time()
    if abs(drift) > 300:
        return {"clock": result(False, "Uhrzeit",
                                f"Hardware-Uhr geht {fmt_duration(abs(drift))} {'vor' if drift > 0 else 'nach'} – "
                                "einmal sudo hwclock --systohc; stimmt sie nach dem nächsten Ausschalten wieder "
                                "nicht: CMOS-Batterie (CR2032) auf der Hauptplatine tauschen", warn=True)}
    return {"clock": result(True, "Uhrzeit", "mit dem Internet abgeglichen · Hardware-Uhr stimmt")}


def check_backup(cfg, active=frozenset()):
    """Wöchentliche Sicherung: letzte erfolgreiche Runde und – bei USB – ob der Datenträger dran ist."""
    _, out, _ = run(["systemctl", "is-enabled", "jms-backup-cloud.timer"], timeout=5)
    if out.strip() != "enabled":
        return {}
    backup_cfg = {}
    try:
        with open(cfg["BACKUP_CONFIG"], encoding="utf-8") as fh:
            for line in fh:
                if "=" in line and not line.lstrip().startswith("#"):
                    k, v = line.strip().split("=", 1)
                    backup_cfg[k] = v.strip('"').strip("'")
    except OSError:
        pass
    problems, parts, only_full = [], [], True
    try:
        with open(cfg["BACKUP_LAST_SUCCESS"], encoding="ascii") as fh:
            last = float(fh.read().strip())
        age = time.time() - last
        parts.append(f"zuletzt {fmt_time(last)}")
        if age > int(cfg["BACKUP_MAX_AGE_HOURS"]) * 3600:
            problems.append(f"letzte erfolgreiche Sicherung vor {fmt_duration(age)}")
            only_full = False
    except (OSError, ValueError):
        parts.append("noch keine wöchentliche Sicherung gelaufen")
    mount = backup_cfg.get("USB_MOUNT")
    if mount:
        # Der Zugriff bindet den Datenträger ein (automount); fehlt er, gibt es die Kennung nicht
        if os.path.isfile(os.path.join(mount, ".jms-backup-disk")):
            usage = shutil.disk_usage(mount)
            percent = round(usage.used * 100 / usage.total)
            parts.append(f"USB {percent} % belegt · {fmt_gb(usage.free)} frei")
            limit = int(cfg["DISK_WARN_PERCENT"])
            if not below(percent, limit, "backup", active):
                problems.append(f"USB-Datenträger über {limit} % voll")
        else:
            problems.append("USB-Datenträger nicht angeschlossen")
            only_full = False
    if problems:
        return {"backup": result(False, "Sicherung", " · ".join(problems + parts), warn=only_full)}
    return {"backup": result(True, "Sicherung", " · ".join(parts))}


# Diese Prüfungen werden während der Sicherung ausgelassen – ihr Zustand bleibt stehen
BACKUP_PAUSED_PREFIXES = ("container:", "docker", "unit:", "failed:", "http:", "tailscale-container:")


def backup_running():
    _, out, _ = run(["systemctl", "is-active", "jms-backup-cloud.service"], timeout=5)
    return out.strip() in ("active", "activating")


def collect(cfg, during_backup, active=frozenset()):
    """Liefert die Ergebnisse und die Schlüssel-Präfixe, deren Zustand diese Runde unbekannt ist.

    active: Schlüssel mit laufender Störung/Warnung (für die Hysterese der Füllstände)."""
    results, unknown = {}, set()
    results.update(check_internet(cfg))
    results.update(check_dns())
    results.update(check_tailscale(["tailscale"], "tailscale:host", "Tailscale (Server)"))
    if during_backup:
        unknown.update(BACKUP_PAUSED_PREFIXES)
    else:
        results.update(check_containers(cfg, unknown))
        results.update(check_units(cfg, unknown))
        results.update(check_http(cfg))
        results.update(check_youtube(cfg, unknown))
    results.update(check_system(cfg, active))
    results.update(check_clock())
    results.update(check_backup(cfg, active))
    return results, unknown


