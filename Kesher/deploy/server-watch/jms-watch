def run(cmd, timeout=10):
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return res.returncode, res.stdout, res.stderr
    except FileNotFoundError:
        return 127, "", "nicht installiert"
    except subprocess.TimeoutExpired:
        return 124, "", "Zeitüberschreitung"


def fmt_time(ts, ref=None):
    """Uhrzeit, mit Datum davor, wenn es nicht derselbe Tag wie ref (Standard: jetzt) ist."""
    ref = ref or time.time()
    dt = datetime.fromtimestamp(ts, TZ)
    if dt.date() == datetime.fromtimestamp(ref, TZ).date():
        return dt.strftime("%H:%M")
    return dt.strftime("%d.%m. %H:%M")


def fmt_duration(seconds):
    minutes = max(1, int(round(seconds / 60)))
    if minutes < 60:
        return f"{minutes} Min."
    hours, minutes = divmod(minutes, 60)
    if hours < 24:
        return f"{hours} Std. {minutes} Min." if minutes else f"{hours} Std."
    days, hours = divmod(hours, 24)
    return f"{days} Tg. {hours} Std." if hours else f"{days} Tg."


def fmt_gb(num_bytes):
    return f"{num_bytes / 1e9:.1f}".replace(".", ",") + " GB"


def words(value):
    return [w for w in value.replace(",", " ").split() if w]


def esc(text):
    return html.escape(str(text), quote=False)


def boot_id():
    try:
        with open("/proc/sys/kernel/random/boot_id", encoding="ascii") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def clock_synced():
    code, out, _ = run(["timedatectl", "show", "-p", "NTPSynchronized", "--value"], timeout=5)
    return code != 0 or out.strip() == "yes"  # ohne timedatectl nicht blockieren


def boot_time():
    with open("/proc/uptime", encoding="ascii") as fh:
        return time.time() - float(fh.read().split()[0])


def result(ok, name, info="", warn=False, quiet=False):
    """warn=True: ein Problem ist eine Warnung (z. B. Speicher fast voll), kein Ausfall.
    quiet=True: nur ein Hinweis in /status, keine Telegram-Meldung (unwichtige Hintergrund-Aufgaben)."""
    item = {"ok": ok, "name": name, "info": info, "warn": warn}
    if quiet:
        item["quiet"] = True
    return item


# Ist eine Warnung aktiv, gilt sie erst 3 Prozentpunkte unter der Grenze als behoben –
# sonst käme bei Werten um die Grenze herum ständig „Warnung“ und „wieder gut“.
HYSTERESIS = 3


def below(value, limit, key, active):
    return value < (limit - HYSTERESIS if key in active else limit)


