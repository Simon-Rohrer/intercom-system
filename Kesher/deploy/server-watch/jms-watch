SHUTDOWN_CMD = re.compile(r"COMMAND=\S*\b(reboot|shutdown|poweroff|halt|systemctl\s+(?:reboot|poweroff|halt|kexec)|init\s+[06])\b.*")


def reboot_reason():
    """Warum war der Server aus? Liest das Ende des Protokolls vom vorherigen Start.

    Liefert (Symbol, Überschrift, Grund)."""
    code, out, _ = run(["journalctl", "-b", "-1", "-o", "cat", "-n", "3000", "--no-pager"], timeout=30)
    if code != 0 or not out.strip():
        return "🔄", "Server wurde neu gestartet", "Grund unbekannt (kein Protokoll vom vorherigen Start)"
    lines = out.splitlines()
    text = "\n".join(lines)
    rebooting = "System is rebooting" in text or "reboot.target" in text
    powering_off = "System is powering down" in text or "poweroff.target" in text or "Power-Off" in text
    clean = rebooting or powering_off

    reason = None
    for line in reversed(lines):
        if "Power key pressed" in line:
            reason = "Ein-/Aus-Knopf am Server gedrückt"
            break
        m = SHUTDOWN_CMD.search(line)
        if m and "COMMAND=" in line:
            user = line.split(" :", 1)[0].strip() if " :" in line else "?"
            reason = f"per Befehl von {user}: {m.group(0)[len('COMMAND='):][:80]}"
            break
        if "unattended-upgrade" in line.lower() and "reboot" in line.lower():
            reason = "automatischer Neustart nach Updates"
            break
    if reason is None and clean:
        reason = "sauber heruntergefahren (Auslöser nicht protokolliert, z. B. über eine Weboberfläche)"
    if not clean:
        tail = "\n".join(lines[-300:])
        if "Out of memory" in tail or "oom-kill" in tail:
            reason = "Arbeitsspeicher voll – danach abgestürzt, nicht sauber heruntergefahren"
        elif "critical temperature" in tail.lower() or ("thermal" in tail.lower() and "shutdown" in tail.lower()):
            reason = "Überhitzung – nicht sauber heruntergefahren"
        elif "Kernel panic" in tail or "BUG:" in tail or "hung_task" in tail:
            reason = "Systemabsturz (Kernel) – nicht sauber heruntergefahren"
        else:
            reason = ("Strom weg oder harter Absturz – der Server wurde nicht heruntergefahren "
                      "(z. B. Stecker, Steckdosenleiste, Stromausfall, Knopf lange gedrückt)")
    if rebooting:
        return "🔄", "Server wurde neu gestartet", reason
    if powering_off:
        return "⏻", "Server war ausgeschaltet", reason
    return "🔌", "Server war plötzlich aus", reason


def evaluate(cfg, state, results, unknown, now):
    fail_after = int(cfg["FAIL_AFTER"])
    internet_fail_after = int(cfg["INTERNET_FAIL_AFTER"])
    ok_after = int(cfg["OK_AFTER"])
    checks = state["checks"]
    results = dict(results)

    # Was in dieser Runde nicht mehr auftaucht (Unit nicht mehr „failed“, Container
    # entfernt), gilt als behoben – außer es wurde gar nicht geprüft (Sicherung, Docker hängt).
    for key in list(checks):
        if key in results or key.startswith(tuple(unknown)):
            continue
        results[key] = result(True, checks[key].get("name") or checks[key].get("label", key))

    for key, item in results.items():
        entry = checks.get(key)
        if item["ok"]:
            if not entry:
                continue
            entry["oks"] = entry.get("oks", 0) + 1
            if entry["oks"] < ok_after and entry.get("alerted"):
                continue
            if entry.get("alerted"):
                since = entry["down_since"]
                name = entry.get("name") or item["name"]
                span = f"{fmt_time(since, now)} – {fmt_time(now, since)} ({fmt_duration(now - since)})"
                was = "Warnung" if entry.get("warn") else "gestört"
                unsent = [i for i in state["outbox"] if i.get("key") == key and i.get("kind") == "down"]
                if unsent:
                    # Die Störungsmeldung ging nie raus (z. B. kein Internet): eine Meldung reicht
                    state["outbox"] = [i for i in state["outbox"] if i not in unsent]
                    head = "hatte eine Warnung" if entry.get("warn") else "war gestört"
                    queue(state, f"🟠 {title(key, name)} {head}\n{span}\n<i>{esc(entry.get('info', ''))}</i>",
                          key, "up")
                else:
                    now_info = f"\n<i>jetzt: {esc(item['info'])}</i>" if entry.get("warn") and item.get("info") else ""
                    queue(state, f"🟢 {title(key, name)} wieder in Ordnung\n{was} {span}{now_info}", key, "up")
            del checks[key]
            continue

        if not entry:
            entry = checks[key] = {"down_since": now, "fails": 0, "alerted": False}
        entry.pop("label", None)
        entry["fails"] += 1
        entry["oks"] = 0
        entry["name"] = item["name"]
        entry["info"] = item["info"]
        entry["warn"] = item.get("warn", False)
        needed = internet_fail_after if key == "internet" else fail_after
        if not entry["alerted"] and entry["fails"] >= needed and not item.get("quiet"):
            entry["alerted"] = True
            if entry["warn"]:
                queue(state, f"⚠️ {title(key, item['name'])} – Warnung\nseit {fmt_time(entry['down_since'], now)}"
                             f"\n<i>{esc(item['info'])}</i>", key, "down")
            else:
                queue(state, f"🔴 {title(key, item['name'])} ausgefallen\nseit {fmt_time(entry['down_since'], now)}"
                             f"\n<i>{esc(item['info'])}</i>", key, "down")


def main_round(cfg):
    now = time.time()
    state = load_state()
    booted = boot_time()

    last_run = state.get("last_run")
    current_boot = boot_id()
    if last_run and state.get("boot_id") and state["boot_id"] != current_boot:
        # Neu gestartet. Die Uhr kann nach einem Stromausfall erst noch falsch gehen (Hardware-Uhr),
        # dann stimmen die Zeiten nicht – mit der Meldung warten, bis die Zeit vom Internet da ist.
        if not clock_synced() and now - booted < 900:
            return
        icon, head, reason = reboot_reason()
        wrong = clock_at_boot(booted)
        clock_note = (f"\n⏰ Beim Start stand die Uhr auf {wrong} – die Hardware-Uhr hält die Zeit nicht "
                      "(CMOS-Batterie CR2032 tauschen)") if wrong else ""
        queue(state, f"{icon} <b>{esc(head)}</b>\n"
                     f"aus von {fmt_time(last_run, now)} bis {fmt_time(booted, now)} (etwa {fmt_duration(booted - last_run)})\n"
                     f"<i>Grund: {esc(reason)}</i>{clock_note}")
    elif not last_run:
        queue(state, "👋 <b>Störungsmeldungen sind eingerichtet</b>\nFällt etwas aus, kommt hier eine Nachricht. "
                     "/status zeigt jederzeit alle Dienste.")
    state["last_run"] = now
    state["boot_id"] = current_boot

    if now - booted < int(cfg["BOOT_GRACE_SECONDS"]):
        # Nach dem Hochfahren starten Container und Dienste noch – nur melden, dass er wieder da ist
        flush_outbox(cfg, state)
        save_state(state)
        return

    results, unknown = collect(cfg, backup_running(), frozenset(state["checks"]))
    evaluate(cfg, state, results, unknown, now)
    youtube_summary(state, now)
    # Für /status: was diese Runde nicht geprüft wurde (Sicherung), mit dem letzten Stand zeigen
    kept = {k: v for k, v in state["last"].items() if k.startswith(tuple(unknown)) and k not in results}
    state["last"] = {**results, **kept}
    state["last_at"] = now
    state.pop("summary", None)
    flush_outbox(cfg, state)
    save_state(state)


def print_status(cfg):
    results, _ = collect(cfg, during_backup=False)
    state = load_state()
    now = time.time()
    state["last"], state["last_at"] = results, now
    # Im Terminal zählt, was jetzt gerade ist: jede Störung rot, ohne Wartezeit
    for key, item in results.items():
        if not item["ok"]:
            state["checks"].setdefault(key, {"down_since": now})["alerted"] = True
    print(plain(render_status(cfg, state, time.time())))
    if state["outbox"]:
        print(f"\n{len(state['outbox'])} Meldung(en) warten noch auf Versand.")
    print("\nBot eingerichtet:", "ja" if cfg["TELEGRAM_BOT_TOKEN"] and cfg["TELEGRAM_CHAT_ID"] else "nein", f"({CONFIG_FILE})")


def find_chat(cfg, wait=180):
    me = telegram(cfg, "getMe", {})
    print(f"Bot: @{me.get('username')} – bitte jetzt in Telegram an den Bot schreiben (z. B. /start) …", file=sys.stderr)
    offset = 0
    deadline = time.time() + wait
    while time.time() < deadline:
        # Kurze Abfragen statt Long-Polling: Manche Firewalls lassen lange offene Anfragen hängen
        try:
            updates = telegram(cfg, "getUpdates", {"offset": offset, "timeout": 0}, timeout=10) or []
        except Exception as e:  # noqa: BLE001 – einzelne Aussetzer abwarten
            print(f"  (Telegram antwortet gerade nicht: {e.__class__.__name__}, neuer Versuch …)", file=sys.stderr)
            updates = []
        if not updates:
            time.sleep(2)
        for upd in updates:
            offset = upd["update_id"] + 1
            chat = (upd.get("message") or {}).get("chat")
            if chat:
                # Gelesene Nachricht bestätigen, damit /start nicht später als Befehl auftaucht
                telegram(cfg, "getUpdates", {"offset": offset, "timeout": 0})
                who = chat.get("title") or " ".join(filter(None, [chat.get("first_name"), chat.get("last_name")]))
                print(f"Gefunden: {who}", file=sys.stderr)
                print(chat["id"])
                return 0
    print("Keine Nachricht erhalten.", file=sys.stderr)
    return 1


def main():
    cfg = load_config()
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--status":
        print_status(cfg)
        return 0
    if arg == "--test":
        send(cfg, f"<b>{esc(cfg['SERVER_NAME'])}</b>\n\n✅ Testnachricht – die Störungsmeldungen kommen hier an.")
        print("Testnachricht gesendet.")
        return 0
    if arg == "--find-chat":
        return find_chat(cfg)
    if arg == "--listen":
        return listen(cfg)
    if arg == "--grund":
        icon, head, reason = reboot_reason()
        print(f"{icon} {head} – an seit {fmt_time(boot_time())}\nGrund: {reason}")
        return 0
    if arg:
        print(__doc__)
        return 1
    main_round(cfg)
    return 0


if __name__ == "__main__":
    sys.exit(main())
