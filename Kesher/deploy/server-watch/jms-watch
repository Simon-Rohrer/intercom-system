def telegram(cfg, method, params, timeout=15):
    token = cfg["TELEGRAM_BOT_TOKEN"]
    if not token:
        raise RuntimeError("TELEGRAM_BOT_TOKEN fehlt in " + CONFIG_FILE)
    data = urllib.parse.urlencode(params).encode()
    req = urllib.request.Request(f"https://api.telegram.org/bot{token}/{method}", data=data)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = json.load(resp)
    except urllib.error.HTTPError as e:
        try:
            body = json.load(e)
        except ValueError:
            raise RuntimeError(f"Telegram-Fehler {e.code}") from None
    if not body.get("ok"):
        raise RuntimeError(body.get("description", "Telegram-Fehler"))
    return body.get("result")


def send(cfg, text):
    """Schickt HTML-Text, bei Bedarf in mehreren Teilen (Telegram: max. 4096 Zeichen)."""
    chunks, current = [], ""
    for part in text.split("\n\n"):
        if current and len(current) + len(part) + 2 > 3800:
            chunks.append(current)
            current = ""
        current = f"{current}\n\n{part}" if current else part
    if current:
        chunks.append(current)
    for chunk in chunks:
        params = {"chat_id": cfg["TELEGRAM_CHAT_ID"], "text": chunk[:4000],
                  "parse_mode": "HTML", "disable_web_page_preview": "true"}
        try:
            telegram(cfg, "sendMessage", params)
        except RuntimeError as e:
            if "parse" not in str(e).lower():
                raise
            # Formatierung kaputt (sollte nicht vorkommen) – dann eben ohne
            params.pop("parse_mode")
            params["text"] = plain(chunk)[:4000]
            telegram(cfg, "sendMessage", params)


def flush_outbox(cfg, state):
    if not state["outbox"] or not cfg["TELEGRAM_BOT_TOKEN"] or not cfg["TELEGRAM_CHAT_ID"]:
        return
    # Eine liegengebliebene Störungsmeldung, deren Problem gerade wieder gut aussieht, noch
    # zurückhalten: Bestätigt sich das, wird daraus eine einzige „war gestört von … bis …“-Meldung.
    def recovering(item):
        entry = state["checks"].get(item.get("key") or "")
        return item.get("kind") == "down" and entry is not None and entry.get("oks", 0) > 0
    ready = [i for i in state["outbox"] if not recovering(i)]
    if not ready:
        return
    text = f"<b>{esc(cfg['SERVER_NAME'])}</b>\n\n" + "\n\n".join(item["text"] for item in ready)
    if any(i.get("kind") == "down" for i in ready):
        text += "\n\nAlle Dienste: /status"
    try:
        send(cfg, text)
    except Exception as e:  # noqa: BLE001 – bleibt im Postausgang, nächste Runde
        if state.get("outbox_reported") != len(state["outbox"]):
            print(f"Telegram nicht erreichbar, {len(state['outbox'])} Meldung(en) warten: {e}", file=sys.stderr)
            state["outbox_reported"] = len(state["outbox"])
        return
    state["outbox"] = [i for i in state["outbox"] if i not in ready]
    state.pop("outbox_reported", None)


def queue(state, text, key=None, kind=None):
    state["outbox"].append({"text": text, "key": key, "kind": kind})
    del state["outbox"][:-MAX_OUTBOX]


def listen(cfg, interval=3):
    """Beantwortet /status im eingetragenen Chat innerhalb weniger Sekunden.

    Kurze Abfragen statt Long-Polling, weil die Firewall lange offene Anfragen hängen lässt.
    Andere Chats bekommen keine Antwort. Der Zustand stammt aus der letzten Prüfrunde.
    """
    if not cfg["TELEGRAM_BOT_TOKEN"] or not cfg["TELEGRAM_CHAT_ID"]:
        print("Bot nicht eingerichtet – " + CONFIG_FILE, file=sys.stderr)
        return 1
    try:
        with open(OFFSET_FILE, encoding="ascii") as fh:
            offset = int(fh.read().strip() or 0)
    except (FileNotFoundError, ValueError):
        offset = 0
    pause, failing = interval, False
    while True:
        try:
            updates = telegram(cfg, "getUpdates", {"offset": offset, "timeout": 0}, timeout=10) or []
            pause, failing = interval, False
        except Exception as e:  # noqa: BLE001 – kein Internet o. Ä.: langsamer weiter versuchen
            if not failing:
                print(f"Telegram nicht erreichbar ({e.__class__.__name__}), versuche es weiter …", file=sys.stderr)
            pause, failing = min(pause * 2, 60), True
            updates = []
        for upd in updates:
            offset = upd["update_id"] + 1
            msg = upd.get("message") or {}
            if str(msg.get("chat", {}).get("id")) != str(cfg["TELEGRAM_CHAT_ID"]):
                continue
            text = (msg.get("text") or "").strip().lower()
            if text.startswith(("/status", "/start")):
                try:
                    send(cfg, render_status(cfg, load_state(), time.time()))
                except Exception as e:  # noqa: BLE001
                    print(f"Antwort nicht gesendet: {e}", file=sys.stderr)
        if updates:
            os.makedirs(os.path.dirname(OFFSET_FILE), exist_ok=True)
            with open(OFFSET_FILE, "w", encoding="ascii") as fh:
                fh.write(str(offset))
        time.sleep(pause)


