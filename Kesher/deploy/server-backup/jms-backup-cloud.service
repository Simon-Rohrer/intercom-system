[Unit]
Description=JMS-Server: nächtliche verschlüsselte Sicherung (restic)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/jms-backup --cloud
# Hochladen soll den laufenden Betrieb nicht ausbremsen
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
